# Application Configuration
APP_NAME=CV Raman Health Care
APP_VERSION=2.0.0
PAGINATION_PAGE_SIZE=50
MAX_CONTENT_LENGTH=16777216

# =============================================================================
# AUDIT & COMPLIANCE
# =============================================================================

# Audit Logging
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years (healthcare compliance)

# Consent Management
CONSENT_DEFAULT_DURATION_DAYS=365  # Default: 1 year
REQUIRE_CONSENT_FOR_PATIENT_DATA=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable features
FEATURE_PROCESSING_PIPELINE=true      # Use hybrid processing layer
FEATURE_LEGACY_JSONB_BACKUP=true      # Keep JSONB backup in submissions
FEATURE_AUTO_CREATE_PATIENT=true      # Auto-create patient from demographics
FEATURE_AUTO_CREATE_ENCOUNTER=true    # Auto-create encounter if needed
FEATURE_CLINICAL_DATA_EXTRACTION=true # Extract vitals, diagnoses, etc.

# =============================================================================
# ABDM INTEGRATION (For Future Use)
# =============================================================================

ABDM_ENABLED=false
ABDM_ENVIRONMENT=sandbox  # sandbox or production
# LLM Configuration
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
DEFAULT_LLM_PROVIDER=openai

# File Upload
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=xlsx,xls,csv,pdf

# Bulk Import Settings
MAX_APPOINTMENTS_PER_BATCH=1000
AUTO_CREATE_PATIENTS=true
CONFLICT_RESOLUTION_ENABLED=true
FUZZY_MATCH_THRESHOLD=80

