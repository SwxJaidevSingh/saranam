# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/cv_raman_health
# For Supabase, use:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hour in seconds
JWT_REFRESH_TOKEN_EXPIRES=2592000  # 30 days in seconds

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Gemini — used for clinical assessment AI summaries
# Free key from https://aistudio.google.com/apikey  (key name: saranam-summary-key)
SARANAM_SUMMARY_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Application Configuration
APP_NAME=CV Raman Health Care
APP_VERSION=1.0.0
PAGINATION_PAGE_SIZE=50
MAX_CONTENT_LENGTH=16777216  # 16MB max file size

# Cloudinary — used for doctor signature uploads on prescriptions (meeting §5.4).
# Grab these from https://cloudinary.com/console (Dashboard → "API Environment variable").
# Either set CLOUDINARY_URL OR the three CLOUDINARY_* vars below — not both.
# If none are set, signatures fall back to base64 storage in providers.signature_image.
#
# Option A (single):
# CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
#
# Option B (three vars):
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=AbCdEfGhIjKlMnOpQrStUvWxYz-0
# ---------------- Teleconsult ----------------
ENABLEX_APP_ID=
ENABLEX_APP_KEY=
ENABLEX_VOICE_CALLER_ID=
ENABLEX_BASE_URL=https://api.enablex.io
ENABLEX_VIDEO_PATH=/video/v1
ENABLEX_VOICE_PATH=/voice/v1
ENABLEX_WA_PATH=/whatsapp/v1
ENABLEX_SMS_PATH=/sms/v1
ENABLEX_TOOLKIT_URL=https://video.enablex.io
ENABLEX_WEBHOOK_SECRET=
ENABLEX_MOCK=false

# Voice vendor — "enablex" (default) or "twilio" (demo / paid alternative).
TELECONSULT_VOICE_VENDOR=enablex

# Twilio (used only when TELECONSULT_VOICE_VENDOR=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

TELECONSULT_TIMEZONE=Asia/Kolkata
TELECONSULT_CLINIC_NAME=Saranam Palliative Care
TELECONSULT_CLINIC_EMAIL=team@exatorial.com

# ---------------- Google Meet (primary video provider) ----------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5002/api/teleconsult/google/oauth/callback
GOOGLE_MEET_HOST_EMAIL=
TELECONSULT_VIDEO_PRIMARY=google_meet
TELECONSULT_VIDEO_FALLBACK=enablex
